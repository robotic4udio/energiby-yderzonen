[Unit]
Description=Start Video Display for the Oven in YderZonen Energiby
After=sound.target
Wants=sound.target

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/energiby/.Xauthority
ExecStart=bash /home/energiby/repositories/energiby-yderzonen/oven_video_display.py
Restart=always
RestartSec=10s
KillMode=process
TimeoutSec=infinity

[Install]
WantedBy=graphical.target

