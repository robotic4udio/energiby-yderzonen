[Unit]
Description=Start Video Display for the Oven in YderZonen Energiby
After=sound.target
Wants=sound.target

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/energiby/.Xauthority
WorkingDirectory=/home/energiby/repositories/energiby-yderzonen
ExecStart=bash run_optimized.sh
Restart=always
RestartSec=10s
KillMode=process
TimeoutSec=infinity

[Install]
WantedBy=graphical.target

